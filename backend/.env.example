# Oculide Backend Environment Variables (Template)
# Copy this file to backend/.env and fill in secure values before running.

APP_NAME="Oculide Core API"
DEBUG=False

# Required Database Settings
DATABASE_DRIVER="ODBC Driver 18 for SQL Server"
DATABASE_SERVER=localhost
DATABASE_NAME=ExamSystem
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Required Security & JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=45

# Required LiveKit SFU
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional Redis & SMTP
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
FRONTEND_URL=http://localhost:3000
